# ---------------------------------------------------------------------------
# Copie ce fichier en `.env` pour le developpement local.
# Sur Render, toutes ces variables sont declarees dans render.yaml.
# ---------------------------------------------------------------------------

# URL publique du service (Render injecte RENDER_EXTERNAL_URL automatiquement)
PUBLIC_BASE_URL=http://localhost:8000

# Base de donnees Postgres (Render la fournit via le blueprint)
DATABASE_URL=postgresql://user:password@localhost:5432/verif

# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe du dashboard d'administration
ADMIN_PASSWORD=change-moi

# Secret de signature des cookies / du state OAuth2 (genere par Render en prod)
SESSION_SECRET=une-longue-chaine-aleatoire

# Lancer le bot Discord dans le meme process que le dashboard
RUN_BOT=true

# Scopes OAuth2 demandes (guilds.join permet de forcer l'ajout au serveur)
DEFAULT_SCOPES=identify email guilds guilds.join

# Nom du role attribue apres verification
VERIFY_ROLE_NAME=Verifie
